# ─────────────────────────────────────────────────────────────────
# Veltra CMS — environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────

# Public keys (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose this publicly, server/scripts only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Personal access token — used by npm run setup to apply migrations automatically
# Get it from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# ── Branding ──────────────────────────────────────────────────────────────────
# Brand identity (name, colors, fonts, logo) lives in config/brand.ts — edit
# that file and commit it. No env vars needed for branding.

# ── Testing (optional) ────────────────────────────────────────────────────────
# Used by Playwright E2E tests — provide an existing admin account
TEST_ADMIN_EMAIL=your-admin@email.com
TEST_ADMIN_PASSWORD=your-admin-password
