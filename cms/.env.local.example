# ─────────────────────────────────────────────────────────────────────────────
# Veltra CMS — environment variables
# Copy this file to .env.local and fill in your values.
#
# BRANDING is NOT configured here.
# Edit config/brand.ts and commit it — that file is versioned alongside code.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public keys (safe to expose in the browser) ───────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Secret keys (server-side only — never expose publicly) ───────────────────

# Service role key — full database access, used by setup and seed scripts only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Personal access token — used by npm run setup to apply migrations automatically
# Generate one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token-here

# ── Testing (optional) ────────────────────────────────────────────────────────
# Required for Playwright E2E tests — must be an existing admin account

TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=your-test-password-here
